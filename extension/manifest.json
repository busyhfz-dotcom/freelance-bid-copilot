{
  "manifest_version": 3,
  "name": "Freelance Bid Copilot",
  "version": "0.7.1",
  "description": "Project-specific concise bidding for Kaya and Ponisha with competitive budget pricing, canonical duplicate filtering, blocked-country filtering, and guarded proposal submission.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://freelancerpanel.ir/*",
    "https://www.freelancerpanel.ir/*",
    "https://*.kaya.ir/*",
    "https://kaya.ir/*",
    "https://*.ponisha.ir/*",
    "https://ponisha.ir/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Bid Copilot",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*.kaya.ir/*",
        "https://kaya.ir/*",
        "https://*.ponisha.ir/*",
        "https://ponisha.ir/*"
      ],
      "js": [
        "adapter-core.js",
        "adapters.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
