PANEL_URL=https://panel.example.com
COPILOT_KEY=replace-with-the-panel-key
WORKER_KEY=replace-with-at-least-24-random-characters
WORKER_ID=primary-worker

FREELANCER_PROFILE=
PREFERRED_DOMAINS=Web/UI,WordPress/CMS
KAYA_LIST_URL=https://kaya.ir/projects
PONISHA_LIST_URL=https://ponisha.ir/search/projects

# Create these locally with npm run capture-auth -- kaya/ponisha, then place them in the mounted volume.
KAYA_STORAGE_STATE_PATH=/data/auth/kaya.storage-state.json
PONISHA_STORAGE_STATE_PATH=/data/auth/ponisha.storage-state.json
# Alternative for first boot: secret Base64 values. The worker writes them to the paths above.
KAYA_STORAGE_STATE_B64=
PONISHA_STORAGE_STATE_B64=

SCAN_INTERVAL_SECONDS=300
# Retry a marketplace that shows login/CAPTCHA only after this cooldown; other sites continue normally.
BLOCKED_SITE_RETRY_MINUTES=15
APPROVAL_POLL_SECONDS=15
INSPECT_LIMIT_PER_SITE=5
TOP_BIDS_PER_CYCLE=1
PORT=8080

# Temporary, human-operated Railway login desktop. Keep disabled except while
# completing a manual Ponisha login/CAPTCHA, then remove all three variables.
PONISHA_REMOTE_LOGIN_ENABLED=false
PONISHA_REMOTE_LOGIN_PASSWORD=
PONISHA_REMOTE_LOGIN_TTL_MINUTES=30
