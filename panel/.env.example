# Shared secret used by the browser extension when calling the local panel.
COPILOT_KEY=change-me

# Private panel login. Password must be 12+ characters; session secret must be 32+ characters.
PANEL_USERNAME=
PANEL_PASSWORD=
PANEL_SESSION_SECRET=

# AI provider. Groq is the recommended free-tier option.
# If AI_PROVIDER is omitted and GROQ_API_KEY exists, Groq is selected automatically.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional generic OpenAI-compatible provider overrides.
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=https://example.com/v1

# Optional OpenAI fallback / legacy configuration.
OPENAI_API_KEY=
OPENAI_MODEL=

# Hosted persistence. Without this value, development falls back to panel/.data/*.json.
DATABASE_URL=

# Set to require for hosted PostgreSQL providers that enforce TLS.
DATABASE_SSL=require

# Keep reads protected on a hosted domain. Set false only for a deliberately public dashboard.
COPILOT_PROTECT_READS=true

# Separate long random secret used only by the always-on Browser Worker.
WORKER_KEY=

# Telegram approval workflow. Keep all values server-side.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_WEBHOOK_SECRET=

# Automation limits. Only guarded BID records at or above this score enter the queue.
AUTOMATION_MIN_SCORE=72
AUTOMATION_MAX_PENDING=10
# Shared daily Telegram cap across Kaya and Ponisha, counted by the Tehran calendar day.
AUTOMATION_DAILY_TELEGRAM_LIMIT=10
APPROVAL_TTL_MINUTES=30
# Suppress identical Worker alerts during this persistent cooldown window.
WORKER_ALERT_COOLDOWN_MINUTES=30
# Keep the Telegram chat focused on real approval cards; operational events remain visible in Reports.
TELEGRAM_WORKER_ALERTS_ENABLED=false
